<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and older backup rules (android:fullBackupContent, set by scripts/build-android.ps1).
     The same excludes as after_you_backup_rules.xml; see the note there. -->
<full-backup-content>
    <exclude domain="file" path="relay-online" />
    <exclude domain="file" path="photo-transfer" />
    <exclude domain="file" path="safety" />
    <exclude domain="file" path="photo-library" />
    <exclude domain="file" path="turn-photos" />
    <exclude domain="file" path="photo-capture-resume" />
    <exclude domain="file" path="cloud-save-staging" />
    <exclude domain="sharedpref" path="." />
    <exclude domain="database" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
