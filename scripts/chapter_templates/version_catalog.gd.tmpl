extends RefCounted
## {{KEY}}: {{EARLIER}}'s definition as version {{VERSION}}, pinned to open
## turns (core/physical/open_turns.gd: 15 after the tide rules, else 14), so it
## never shares a record with an earlier version, its controls carry no owner,
## and a stage passes back and forth until both pips end a turn at its goal, up
## to its cap. Its words are the descriptor's copy and stage_copy, never the
## definition's, and its turn limits are the development ones
## (content/chapters/index.gd DEVELOPMENT_TURN_LIMITS, the same for every turn)
## until play sets them (scripts/chapter_turn_limits.py).
const Earlier = preload("{{EARLIER_SCRIPT}}")
const OpenTurns = preload("res://core/physical/open_turns.gd")
const WORDS := ["title", "subtitle", "hint_a", "hint_b"]
## Turns a stage may take, by stage id: a stage left out keeps its earlier cap,
## or 10. The owner sets 20 on hard stages.
const CAPS := {}

static func definition() -> Dictionary:
	var level: Dictionary = Earlier.{{EARLIER_CALL}}.duplicate(true)
	level.version = {{VERSION}}
	OpenTurns.pin(level, CAPS)
	level.turn_limits = {{DEV_TURN_LIMITS}}
	for field: String in WORDS:
		level.erase(field)
		for stage: Dictionary in level.stages: stage.erase(field)
	return level
