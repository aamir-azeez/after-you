{
  "name": "after-you-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --ip 127.0.0.1 --port 8791",
    "types": "wrangler types",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test/tsconfig.json",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && wrangler deploy --dry-run",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.1.9",
    "@cloudflare/workers-types": "5.20260914.1",
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "wrangler": "4.131.2"
  }
}
