{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "after-you-rooms",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-14",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "send_metrics": false,
  "vars": {
    "ENVIRONMENT": "test-store",
    "REVENUECAT_API_VERSION": "2",
    "REVENUECAT_ENTITLEMENT": "full_journey"
  },
  "durable_objects": {
    "bindings": [
      {"name": "PLAYERS", "class_name": "Player"},
      {"name": "ROOMS", "class_name": "Room"}
    ]
  },
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["Player", "Room"]}],
  "ratelimits": [
    {"name": "PUBLIC_LIMITER", "namespace_id": "583701", "simple": {"limit": 20, "period": 60}},
    {"name": "PLAYER_LIMITER", "namespace_id": "583702", "simple": {"limit": 120, "period": 60}}
  ],
  "observability": {"enabled": false}
}
