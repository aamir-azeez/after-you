{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "after-you-rooms",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-14",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "send_metrics": false,
  "vars": {
    "ENVIRONMENT": "test-store",
    "PRESENCE_ENABLED": "false",
    "TESTER_ACCESS_ENABLED": "false",
    "SAFETY_ENFORCEMENT_ENABLED": "false",
    "REVENUECAT_VERIFICATION_MODE": "demo",
    "REVENUECAT_PLAY_ENVIRONMENT": "production",
    "REVENUECAT_DELETION_ENABLED": "false",
    "NOTIFICATIONS_ENABLED": "false",
    "V2_ROOMS_ENABLED": "false",
    "FIRST_STEPS_ENABLED": "false",
    "RELAY_PHOTOS_ENABLED": "false",
    "PRESET_REACTIONS_ENABLED": "false",
    "REVENUECAT_API_VERSION": "2",
    "REVENUECAT_ENTITLEMENT": "full_journey",
    "PHOTO_DELIVERY_ENABLED": "false",
    "PHOTO_TRANSFER_ENABLED": "false"
  },
  "durable_objects": {
    "bindings": [
      { "name": "SAFETY_PROFILES", "class_name": "SafetyProfile" },
      { "name": "SAFETY_INBOX", "class_name": "SafetyInbox" },
      {
        "name": "PLAYERS",
        "class_name": "Player"
      },
      {
        "name": "ROOMS",
        "class_name": "Room"
      },
      {
        "name": "ROOMS_V2",
        "class_name": "RoomV2"
      },
      {
        "name": "PHOTO_TRANSFERS",
        "class_name": "PhotoTransfer"
      },
      {
        "name": "PHOTO_TRANSFER_BUDGET",
        "class_name": "PhotoTransferBudget"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "Player",
        "Room"
      ]
    },
    {
      "tag": "v2-rooms",
      "new_sqlite_classes": [
        "RoomV2"
      ]
    },
    {
      "tag": "photo-transfer-v1",
      "new_sqlite_classes": [
        "PhotoTransfer",
        "PhotoTransferBudget"
      ]
    },
    { "tag": "play-safety-v1", "new_sqlite_classes": ["SafetyProfile", "SafetyInbox"] }
  ],
  "ratelimits": [
    { "name": "TESTER_CODE_LIMITER", "namespace_id": "583705", "simple": { "limit": 5, "period": 60 } },
    {
      "name": "PUBLIC_LIMITER",
      "namespace_id": "583701",
      "simple": {
        "limit": 20,
        "period": 60
      }
    },
    {
      "name": "PLAYER_LIMITER",
      "namespace_id": "583702",
      "simple": {
        "limit": 120,
        "period": 60
      }
    },
    {
      "name": "PHOTO_ACK_LIMITER",
      "namespace_id": "583703",
      "simple": {
        "limit": 60,
        "period": 60
      }
    },
    {
      "name": "PHOTO_TRANSFER_LIMITER",
      "namespace_id": "583704",
      "simple": {
        "limit": 60,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": false
  }
}
