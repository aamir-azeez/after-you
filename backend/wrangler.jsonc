{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "after-you-rooms",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-14",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "send_metrics": false,
  "durable_objects": {
    "bindings": [
      { "name": "SAFETY_PROFILES", "class_name": "SafetyProfile" },
      { "name": "SAFETY_INBOX", "class_name": "SafetyInbox" },
      {
        "name": "PLAYERS",
        "class_name": "Player"
      },
      {
        "name": "FRIEND_ROOM_EVENTS",
        "class_name": "FriendRoomEvents"
      },
      {
        "name": "ROOMS",
        "class_name": "Room"
      },
      {
        "name": "ROOMS_V2",
        "class_name": "RoomV2"
      },
      {
        "name": "PHOTO_TRANSFERS",
        "class_name": "PhotoTransfer"
      },
      {
        "name": "PHOTO_TRANSFER_BUDGET",
        "class_name": "PhotoTransferBudget"
      },
      { "name": "PLATFORM_LINKS", "class_name": "PlatformLinks" },
      { "name": "LEADERBOARD_BOARDS", "class_name": "LeaderboardBoard" },
      { "name": "LEADERBOARD_MEMBERS", "class_name": "LeaderboardMember" },
      { "name": "POLLEN_CLAIMS", "class_name": "PollenClaims" }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "Player",
        "Room"
      ]
    },
    {
      "tag": "v2-rooms",
      "new_sqlite_classes": [
        "RoomV2"
      ]
    },
    {
      "tag": "photo-transfer-v1",
      "new_sqlite_classes": [
        "PhotoTransfer",
        "PhotoTransferBudget"
      ]
    },
    { "tag": "play-safety-v1", "new_sqlite_classes": ["SafetyProfile", "SafetyInbox"] },
    { "tag": "friend-room-events-v1", "new_sqlite_classes": ["FriendRoomEvents"] },
    { "tag": "platform-links-v1", "new_sqlite_classes": ["PlatformLinks"] },
    { "tag": "leaderboards-v1", "new_sqlite_classes": ["LeaderboardBoard", "LeaderboardMember"] },
    { "tag": "pollen-claims-v1", "new_sqlite_classes": ["PollenClaims"] }
  ],
  "ratelimits": [
    { "name": "TESTER_CODE_LIMITER", "namespace_id": "583705", "simple": { "limit": 5, "period": 60 } },
    { "name": "WAITLIST_ADDRESS_LIMITER", "namespace_id": "583706", "simple": { "limit": 1, "period": 60 } },
    {
      "name": "PUBLIC_LIMITER",
      "namespace_id": "583701",
      "simple": {
        "limit": 20,
        "period": 60
      }
    },
    {
      "name": "PLAYER_LIMITER",
      "namespace_id": "583702",
      "simple": {
        "limit": 120,
        "period": 60
      }
    },
    {
      "name": "PHOTO_ACK_LIMITER",
      "namespace_id": "583703",
      "simple": {
        "limit": 60,
        "period": 60
      }
    },
    {
      "name": "PHOTO_TRANSFER_LIMITER",
      "namespace_id": "583704",
      "simple": {
        "limit": 60,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": false
  }
}
