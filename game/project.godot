; After You native Android project.
config_version=5

[application]
config/name="After You"
config/version="0.2.0-preview3"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://assets/icon.svg"
config/use_custom_user_dir=true
config/custom_user_dir_name="AfterYou"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=0

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.055,0.15,0.17,1)
lights_and_shadows/directional_shadow/size=2048

[physics]
common/physics_ticks_per_second=30

[audio]
driver/enable_input=false

[editor_plugins]
enabled=PackedStringArray("res://addons/after_you_android/plugin.cfg")

[editor]
; Serial imports avoid the engine's intermittent parallel font-import crash.
import/use_multiple_threads=false
