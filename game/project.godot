; After You native Android project.
config_version=5

[application]
config/name="After You"
config/version="0.6.2"
; Screens handle Android Back through their existing navigation/save guards.
config/quit_on_go_back=false
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://assets/icon.svg"
; Dedicated splash art (characters only, no rounded plate) on the teal screen.
boot_splash/image="res://assets/boot_splash.png"
boot_splash/bg_color=Color(0.0705882, 0.2235294, 0.2117647, 1)
boot_splash/stretch_mode=0
config/use_custom_user_dir=true
config/custom_user_dir_name="AfterYou"

[autoload]
VersionBadge="*res://presentation/version_badge.gd"
FramePolicy="*res://services/frame_policy.gd"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=0

[gui]

; Lists wait for a finger's slop before scrolling, so a tap that wobbles still
; presses. main.gd replaces this with a density-scaled value at start.
common/default_scroll_deadzone=12

[input_devices]
; Forward small Android drags for the app-owned multi-touch controls.
pointing/android/disable_scroll_deadzone=true

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.055,0.15,0.17,1)
; Every quality hides shadow shapes (services/graphics_policy.gd), so the sun's
; shadow pass only needs a token map; 256 draws the same pixels as 2048.
lights_and_shadows/directional_shadow/size=256

[physics]
common/physics_ticks_per_second=30

[audio]
driver/enable_input=false

[editor_plugins]
enabled=PackedStringArray("res://addons/after_you_android/plugin.cfg")

[editor]
; Serial imports avoid the engine's intermittent parallel font-import crash.
import/use_multiple_threads=false
