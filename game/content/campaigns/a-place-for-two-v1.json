  "story": {
    "schema_version": 1,
    "story_id": "a-place-for-two",
    "story_version": 1,
    "title": "A Place for Two.",
    "summary": "Two little lights discover a house they can call home.",
    "chapters": [
      {
        "level_id": "first-steps",
        "level_version": 1,
        "arrival": [
          {
            "speaker": "p0",
            "text": "There's another light out there."
          },
          {
            "speaker": "p1",
            "text": "I can see your light."
          }
        ],
        "completion": [
          {
            "speaker": "p0",
            "text": "You made it."
          },
          {
            "speaker": "p1",
            "text": "You waited for me."
          }
        ]
      },
      {
        "level_id": "relay-isles",
        "level_version": 2,
        "arrival": [
          {
            "speaker": "p1",
            "text": "I can see a garden here."
          },
          {
            "speaker": "p0",
            "text": "Let's plant one."
          }
        ],
        "completion": [
          {
            "speaker": "p1",
            "text": "One little garden."
          },
          {
            "speaker": "p0",
            "text": "We'll remember the way back."
          }
        ]
      },
      {
        "level_id": "high-and-low",
        "level_version": 1,
        "arrival": [
          {
            "speaker": "p1",
            "text": "I can see rooftops."
          },
          {
            "speaker": "p0",
            "text": "A place to stop?"
          }
        ],
        "completion": [
          {
            "speaker": "p1",
            "text": "The view was nice."
          },
          {
            "speaker": "p0",
            "text": "I missed you."
          }
        ]
      },
      {
        "level_id": "rolling-home",
        "level_version": 1,
        "arrival": [
          {
            "speaker": "p1",
            "text": "There is no light in that little house."
          },
          {
            "speaker": "p0",
            "text": "Let's get closer."
          }
        ],
        "completion": [
          {
            "speaker": "p0",
            "text": "Do you think anyone's home?"
          },
          {
            "speaker": "p1",
            "text": "We could knock."
          }
        ]
      },
      {
        "level_id": "a-house-for-two",
        "level_version": 1,
        "arrival": [
          {
            "speaker": "p0",
            "text": "We can fit two in here."
          },
          {
            "speaker": "p1",
            "text": "May I have the window?"
          }
        ],
        "completion": [
          {
            "speaker": "p0",
            "text": "We can stay here."
          },
          {
            "speaker": "p1",
            "text": "I'd like that."
          }
        ]
      },
      {
        "level_id": "conservatory",
        "level_version": 1,
        "arrival": [
          {
            "speaker": "p0",
            "text": "Want to see what's past the garden?"
          },
          {
            "speaker": "p1",
            "text": "As long as we return home after."
          }
        ],
        "completion": [
          {
            "speaker": "p1",
            "text": "It's getting late."
          },
          {
            "speaker": "p0",
            "text": "Then let's go home."
          }
        ]
      },
      {
        "level_id": "long-way-home",
        "level_version": 1,
        "arrival": [
          {
            "speaker": "p1",
            "text": "I think this is the way."
          },
          {
            "speaker": "p0",
            "text": "Save me a place by the window."
          }
        ],
        "completion": [
          {
            "speaker": "p1",
            "text": "I left it on for you."
          },
          {
            "speaker": "p0",
            "text": "I know."
          }
        ]
      }
    ],
    "content_hash": "015ace9140afb2d67c9acd47506a8108dd838e98278a9ac479166290e45fef16"
  }
}
